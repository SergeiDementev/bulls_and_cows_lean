# Copy to .env and fill in. .env is never committed.

# Local PostgreSQL (docker/compose.dev.yml). 5434, so it does not clash with v1's dev database.
POSTGRES_USER=bulls
POSTGRES_PASSWORD=
POSTGRES_DB=bulls
DB_PORT=5434

# Server. The password in DATABASE_URL is POSTGRES_PASSWORD above.
DATABASE_URL=postgres://bulls:PASSWORD@127.0.0.1:5434/bulls
# Locally any string: it only has to match between the server and pnpm dev:init-data.
# The real token is needed only on the server.
BOT_TOKEN=local-dev-token
PORT=3000
