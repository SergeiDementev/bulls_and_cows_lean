{
  "name": "bulls-and-cows-lean",
  "private": true,
  "description": "Bulls and Cows as a Telegram Mini App, lean rewrite",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage",
    "db:up": "docker compose -f docker/compose.dev.yml --env-file .env up -d --wait",
    "db:down": "docker compose -f docker/compose.dev.yml --env-file .env down",
    "dev": "node --env-file=.env --watch src/server/main.ts",
    "dev:init-data": "node --env-file=.env scripts/dev-init-data.ts",
    "dev:web": "vite",
    "build": "vite build",
    "test:e2e": "playwright test",
    "bot:setup": "node --env-file-if-exists=.env scripts/bot-setup.ts",
    "test:load": "node scripts/load-test.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fluent/bundle": "^0.19.1",
    "fastify": "^5.12.7",
    "kysely": "^0.29.6",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "prettier": {
    "printWidth": 100,
    "trailingComma": "all"
  }
}
