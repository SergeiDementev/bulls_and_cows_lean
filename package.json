{
  "name": "bulls-and-cows-lean",
  "private": true,
  "description": "Bulls and Cows as a Telegram Mini App, lean rewrite",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage",
    "db:up": "docker compose -f docker/compose.dev.yml --env-file .env up -d --wait",
    "db:down": "docker compose -f docker/compose.dev.yml --env-file .env down",
    "dev": "node --env-file=.env --watch src/server/main.ts",
    "dev:init-data": "node --env-file=.env scripts/dev-init-data.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "fastify": "^5.12.7",
    "kysely": "^0.29.6",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
