# The only door from the internet: HTTPS, the Mini App files, /api and the bot webhook.
# /health and everything else of the server stay inside the Docker network.
{
	# HTTP/3 needs UDP, and only TCP 443 is open on the VM
	servers {
		protocols h1 h2
	}
}

{$DOMAIN} {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	handle /api/* {
		reverse_proxy app:3000
	}
	handle /telegram/webhook {
		reverse_proxy app:3000
	}

	# Unknown paths, /health included, get the Mini App page
	handle {
		root * /srv/web
		try_files {path} /index.html
		# Built files get a new name on every build: keep them forever. The page itself is
		# checked every time, so players see a new version right after a deploy
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@page not path /assets/*
		header @page Cache-Control "no-cache"
		file_server
	}
}
