# Settings on the VM: copy to .env in the repository root, chmod 600. Never commit the real file.
# Passwords and WEBHOOK_SECRET: generate on the server with `openssl rand -hex 24`.

DOMAIN=bulls-and-cows-telebot.duckdns.org
POSTGRES_DB=bulls
# The PostgreSQL superuser; only the one-time init script uses it
POSTGRES_PASSWORD=
# The server's own database user (docker/postgres-init.sh)
APP_DB_PASSWORD=
# From @BotFather; the author enters it
BOT_TOKEN=
# Without @; for the "Open the bot" link on a page opened outside Telegram
BOT_USERNAME=
WEBHOOK_SECRET=
LOG_LEVEL=info
# Object Storage namespace for backups (not a secret): oci os ns get --auth instance_principal
OCI_NAMESPACE=
# From the DuckDNS account page; the author enters it. Used by docker/duckdns.sh
DUCKDNS_TOKEN=
